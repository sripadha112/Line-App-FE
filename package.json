{
  "name": "kedulz",
  "version": "1.0.0",
  "main": "index.js",
  "homepage": "https://kedulz.com",
  "scripts": {
    "start": "expo start",
    "start:prod": "cross-env EXPO_PUBLIC_API_ENV=prod expo start",
    "android": "expo start --android",
    "android:prod": "cross-env EXPO_PUBLIC_API_ENV=prod expo start --android",
    "ios": "expo start --ios",
    "ios:prod": "cross-env EXPO_PUBLIC_API_ENV=prod expo start --ios",
    "web": "expo start --web",
    "web:prod": "cross-env EXPO_PUBLIC_API_ENV=prod expo start --web",
    "build": "npm run build:web",
    "build:web": "expo export --platform web && node scripts/copy-static-files.js",
    "serve": "npx serve dist -s -l 3000",
    "build:android": "eas build --profile preview --platform android --clear-cache",
    "build:apk": "eas build --profile preview --platform android --clear-cache",
    "build:development-client": "eas build --profile development --platform android",
    "build:ios": "eas build --profile production --platform ios --clear-cache",
    "build:preview": "eas build --profile preview --platform android --clear-cache",
    "build:production": "eas build --profile production --platform android --clear-cache",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.36",
    "expo-application": "^7.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.8",
    "expo-device": "^8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.12",
    "expo-media-library": "^18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-content-loader": "^7.1.2",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-qr-code": "^2.0.18"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
